# LLM Configuration (JD Cloud Claude Proxy)
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://modelservice.jdcloud.com/anthropic
ANTHROPIC_MODEL=Claude-Sonnet-4.6

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gfcri_db
POSTGRES_USER=gfcri
POSTGRES_PASSWORD=changeme

# Application
APP_ENV=development
LOG_LEVEL=INFO
DAILY_RUN_HOUR=6
DAILY_RUN_MINUTE=0
TZ=Asia/Shanghai
PUBLIC_BASE_URL=https://your-domain.example

# Market data cache refresh
# Refresh historical market data before risk-index calculation. Successful
# external fetches are persisted to market_data_daily before model use.
MARKET_DATA_REFRESH_ENABLED=true
MARKET_DATA_REFRESH_HOUR=3
MARKET_DATA_REFRESH_MINUTE=0
MARKET_DATA_REFRESH_PERIOD=2y
MARKET_DATA_REFRESH_ON_STARTUP=true
MARKET_DATA_MAX_STALE_DAYS=7
YFINANCE_BATCH_SIZE=5
YFINANCE_SLEEP_SECONDS=10
YFINANCE_DISABLE_ONLINE=false
TUSHARE_TOKEN=

# Personal subscription billing
# Stripe Checkout is used when these values are configured. The API returns a
# BILLING_NOT_CONFIGURED error instead of creating a fake checkout session when
# keys are missing.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
BILLING_SUCCESS_URL=https://your-domain.example/billing/success
BILLING_CANCEL_URL=https://your-domain.example/pricing

# WeChat Official Account (auto-publish)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTO_PUBLISH=false

# Waffo Pancake personal subscription billing
WAFFO_ENVIRONMENT=sandbox
WAFFO_MERCHANT_ID=
WAFFO_API_KEY=
WAFFO_PRIVATE_KEY=
WAFFO_PUBLIC_KEY=
WAFFO_MONTHLY_PLAN_ID=
WAFFO_ANNUAL_PLAN_ID=
WAFFO_NOTIFY_URL=https://your-domain.example/api/billing/waffo/webhook

# Email subscription delivery via AWS SES SMTP
EMAIL_ENABLED=false
SES_SMTP_HOST=email-smtp.us-west-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_FROM_EMAIL=
SES_FROM_NAME=GFCRI
SES_REPLY_TO=